+    // Forget bytes the pointer has consumed so a long movie cannot grow the
+    // buffer without bound.
+    const uint64_t consumedBytes = m_ipuBitPos >> 3u;
+    if (consumedBytes > 0x10000u)
+    {
+        m_ipuIn.erase(m_ipuIn.begin(), m_ipuIn.begin() + static_cast<std::ptrdiff_t>(consumedBytes));
+        m_ipuBitPos -= consumedBytes << 3u;
+    }
+}
+
+uint32_t PS2Memory::ipuReadCmdBits()
+{
+    ipuChainPump(8u);
+
+    static uint32_t s_readTrace = 0u;
+    if (std::getenv("PS2X_TRACE_IPU") != nullptr && s_readTrace < 400u &&
+        (s_readTrace < 8u || m_ipuBitPos < (static_cast<uint64_t>(m_ipuIn.size()) * 8u)))
+    {
+        const uint64_t bytePos = m_ipuBitPos >> 3u;
+        const uint32_t bitOff = static_cast<uint32_t>(m_ipuBitPos & 7u);
+        uint64_t window = 0u;
+        for (uint32_t i = 0u; i < 8u; ++i)
+        {
+            const uint64_t idx = bytePos + i;
+            window = (window << 8u) | (idx < m_ipuIn.size() ? m_ipuIn[static_cast<size_t>(idx)] : 0u);
+        }
+        const uint32_t bits = static_cast<uint32_t>((window >> (32u - bitOff)) & 0xFFFFFFFFu);
+        std::cerr << "[ipu:rd]  #" << s_readTrace << " bits=0x" << std::hex << bits << std::dec
+                  << " bitPos=" << m_ipuBitPos << " buffered=" << m_ipuIn.size()
+                  << " chain=" << (m_ipuChainActive ? 1 : 0)
+                  << " starved=" << (bytePos + 8u > m_ipuIn.size() ? 1 : 0) << std::endl;
+        ++s_readTrace;
+    }
+
+    // The 32 bits at the bit pointer, big-endian.
+    const uint64_t bytePos = m_ipuBitPos >> 3u;
+    const uint32_t bitOff = static_cast<uint32_t>(m_ipuBitPos & 7u);
+    uint64_t window = 0u;
+    for (uint32_t i = 0u; i < 8u; ++i)
+    {
+        const uint64_t idx = bytePos + i;
+        const uint8_t byte = idx < m_ipuIn.size() ? m_ipuIn[static_cast<size_t>(idx)] : 0u;
+        window = (window << 8u) | byte;
+    }
+    return static_cast<uint32_t>((window >> (32u - bitOff)) & 0xFFFFFFFFu);
+}
+
+void PS2Memory::ipuRunChannelDma(uint32_t channelBase, uint32_t chcr)
+{
+    const uint32_t mode = (chcr >> 2u) & 0x3u;
+    const uint32_t qwc = m_ioRegisters[channelBase + 0x20u] & 0xFFFFu;
+    const uint32_t madr = m_ioRegisters[channelBase + 0x10u] & 0x7FFFFFF0u;
+
+    static uint32_t s_dmaTrace = 0u;
+    if (std::getenv("PS2X_TRACE_IPU") != nullptr && s_dmaTrace < 32u)
+    {
+        std::cerr << "[ipu:dma] #" << s_dmaTrace << " ch=0x" << std::hex << channelBase << std::dec
+                  << " chcr=0x" << std::hex << chcr << std::dec
+                  << " mode=" << mode << " madr=0x" << std::hex << madr << std::dec
+                  << " tadr=0x" << std::hex << m_ioRegisters[channelBase + 0x30u] << std::dec
+                  << " qwc=" << qwc << std::endl;
+        ++s_dmaTrace;
+    }
+
+    auto appendGuest = [this](uint32_t addr, uint32_t qwCount)
+    {
+        uint32_t bytes = qwCount * 16u;
+        uint32_t phys = 0u;
+        try
+        {
+            phys = translateAddress(addr);
+        }
+        catch (const std::exception &)
+        {
+            return;
+        }
+        while (bytes > 0u)
+        {
+            if (phys >= PS2_RAM_SIZE)
+                phys = 0u;
+            uint32_t chunk = bytes;
+            if (phys + chunk > PS2_RAM_SIZE)
+                chunk = PS2_RAM_SIZE - phys;
+            if (chunk == 0u)
+                break;
+            ipuFeed(m_rdram + phys, chunk);
+            bytes -= chunk;
+            phys += chunk;
+        }
+    };
+
+    // Directions: DMA4 "IPU_TO" (0x1000B400) carries data *to* the IPU, i.e. the
+    // elementary stream that fills the bitstream FIFO; DMA3 "IPU_FROM"
+    // (0x1000B000) carries decoded macroblocks back out.
+    if (channelBase == 0x1000B400u) // bitstream input
+    {
+        if (mode == 1u)
+        {
+            // Chain mode: remember where the chain starts and let ipuChainPump pull
+            // chunks on demand. The stream buffer is filled by the CD stream while
+            // the parser runs, so copying at kick time reads it before it arrives.
+            m_ipuChainActive = true;
+            m_ipuChainTagAddr = m_ioRegisters[channelBase + 0x30u];
+            m_ipuChainDataAddr = 0u;
+            m_ipuChainRemainingQw = 0u;
+        }
+        else if (mode == 0u && qwc > 0u)
+        {
+            appendGuest(madr, qwc);
+        }
+    }
+    // DMA3 (0x1000B000) drains decoded data; nothing is produced yet, so the
+    // transfer simply completes.
+
+    m_ioRegisters[channelBase + 0x20u] = 0u;            // QWC drained
+    m_ioRegisters[channelBase + 0x00u] = chcr & ~0x100u; // clear start/busy
+}
+
+// Pull the next bitstream chunk(s) from the IPU input chain when the parser needs
+// them. Runs against current guest RAM, so it picks up data the CD stream has
+// delivered in the meantime; a chunk that is still all-zero is treated as "not
+// delivered yet" and retried later (hardware would stall at that point).
+void PS2Memory::ipuChainPump(size_t wantBytes)
+{
+    if (!m_ipuChainActive)
+        return;
+
+    size_t guard = 0u;
+    while ((static_cast<size_t>(m_ipuBitPos >> 3u) + wantBytes > m_ipuIn.size()) && (guard++ < 64u))
+    {
+        if (m_ipuChainRemainingQw == 0u)
+        {
+            uint32_t physTag = 0u;
+            try
+            {
+                physTag = translateAddress(m_ipuChainTagAddr);
+            }
+            catch (const std::exception &)
+            {
+                m_ipuChainActive = false;
+                return;
+            }
+            if (physTag + 16u > PS2_RAM_SIZE)
+            {
+                m_ipuChainActive = false;
+                return;
+            }
+
+            uint64_t tag = 0u;
+            std::memcpy(&tag, m_rdram + physTag, sizeof(tag));
+            const uint32_t qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+            const uint32_t id = static_cast<uint32_t>((tag >> 28u) & 0x7u);
+            const uint32_t addr = static_cast<uint32_t>((tag >> 32u) & 0x7FFFFFFFu);
+            const uint32_t tagAddr = m_ipuChainTagAddr;
+
+            switch (id)
+            {
+            case 1u: // cnt: data follows the tag, next tag follows the data
+                m_ipuChainDataAddr = tagAddr + 16u;
+                m_ipuChainTagAddr = m_ipuChainDataAddr + qwc * 16u;
+                break;
+            case 2u: // next: data follows the tag, next tag at addr
+                m_ipuChainDataAddr = tagAddr + 16u;
+                m_ipuChainTagAddr = addr;
+                break;
+            case 3u: // ref: data at addr, next tag follows this one
+            case 4u: // refe
+                m_ipuChainDataAddr = addr;
+                m_ipuChainTagAddr = tagAddr + 16u;
+                break;
+            default: // 0 = end, 7 = end; nothing left to feed
+                m_ipuChainActive = false;
+                return;
+            }
+
+            if (qwc == 0u)
+                continue;
+
+            uint32_t physData = 0u;
+            try
+            {
+                physData = translateAddress(m_ipuChainDataAddr);
+            }
+            catch (const std::exception &)
+            {
+                m_ipuChainActive = false;
+                return;
+            }
+            if (physData + 32u > PS2_RAM_SIZE)
+            {
+                m_ipuChainActive = false;
+                return;
+            }
+            bool delivered = false;
+            for (uint32_t i = 0u; i < 32u; ++i)
+            {
+                if (m_rdram[physData + i] != 0u)
+                {
+                    delivered = true;
+                    break;
+                }
+            }
+            if (!delivered)
+                return;
+
+            m_ipuChainRemainingQw = qwc;
+        }
+
+        const uint32_t bytes = m_ipuChainRemainingQw * 16u;
+        uint32_t phys = 0u;
+        try
+        {
+            phys = translateAddress(m_ipuChainDataAddr);
+        }
+        catch (const std::exception &)
+        {
+            m_ipuChainActive = false;
+            return;
+        }
+        uint32_t left = bytes;
+        uint32_t p = phys;
+        while (left > 0u)
+        {
+            if (p >= PS2_RAM_SIZE)
+                p = 0u;
+            uint32_t chunk = left;
+            if (p + chunk > PS2_RAM_SIZE)
+                chunk = PS2_RAM_SIZE - p;
+            if (chunk == 0u)
+                break;
+            ipuFeed(m_rdram + p, chunk);
+            p += chunk;
+            left -= chunk;
+        }
+        m_ipuChainDataAddr += bytes;
+        m_ipuChainRemainingQw = 0u;
+
+        static uint32_t s_pumpTrace = 0u;
+        if (std::getenv("PS2X_TRACE_IPU") != nullptr && s_pumpTrace < 6u)
+        {
+            std::cerr << "  [ipu:pump] +" << bytes << " total=" << m_ipuIn.size() << std::endl;
+            ++s_pumpTrace;
+        }
+    }
+}
