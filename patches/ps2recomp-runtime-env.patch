+            s_cadence = spec ? static_cast<uint32_t>(std::strtoul(spec, nullptr, 0)) : 0u;
+        }
+
+        if (s_cadence != 0u && runtime != nullptr)
+        {
+            if (!s_announced)
+            {
+                std::cerr << "[DIAG] PS2X_DIAG_FORCE_MOVIE_DONE=" << s_cadence
+                          << ": invoking the guest movie teardown every " << s_cadence
+                          << " pad polls. DIAGNOSTIC ONLY." << std::endl;
+                s_announced = true;
+            }
+
+            if ((++s_polls % s_cadence) == 0u)
+            {
+                // Set the movie player object's state to 3, which is the state its
+                // own per-frame pump maps to "stream finished". The pump then calls
+                // the real teardown (FUN_00224308) itself, so the game's own state
+                // machine performs the transition; nothing here writes the exposed
+                // "movie done" flag directly.
+                constexpr uint32_t kPlayerStateAddr = 0x663C00u; // 0x663B58 + 0xA8
+                constexpr uint32_t kShellOpeningDone = 0x4BD710u;
+                if (rdram != nullptr)
