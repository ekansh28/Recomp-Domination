+    // move past the data actually held. Without this clamp a guest that polls
+    // for bits it never receives (movie data not fed yet) would advance the
+    // pointer without bound and the trim below would erase past the end.
+    const uint64_t availableBits = static_cast<uint64_t>(m_ipuIn.size()) * 8u;
