+// ---------------------------------------------------------------------------
+// EE IPU bitstream interface.
+//
+// MPEG1/MPEG2 on the PS2 is decoded by the EE's Image Processing Unit. The game
+// ships its own MPEG player, which drives the IPU directly: the IPU_FROM DMA
+// channel fills the IPU input FIFO with elementary-stream bytes, and the parser
+// reads syntax bits with the "fetch N bits" command - write IPU_CMD = N |
+// 0x40000000 (FDEC) and read IPU_CMD back, which returns the 32 bits at the bit
+// pointer IPU_BP; FDEC advances that pointer by N. Command 0 (BCLR) clears the
+// input FIFO and sets the pointer. (PCSX2's IPU.cpp is the reference:
+// ipuRead32(IPU_CMD) -> getBits32 + BigEndian, IPUCMD_WRITE -> g_BP.Advance.)
+//
+// Only the bitstream side is modelled: IDEC/BDEC (the IDCT that actually
+// produces macroblocks) are not implemented, so no picture is produced yet, but
+// the elementary stream parses and completes.
+void PS2Memory::ipuReset()
+{
+    m_ipuIn.clear();
+    m_ipuBitPos = 0u;
+    m_ipuCtrl = 0u;
+}
+
+void PS2Memory::ipuFeed(const uint8_t *data, size_t size)
+{
+    if (!data || size == 0u)
+        return;
+    m_ipuIn.insert(m_ipuIn.end(), data, data + size);
+}
+
+void PS2Memory::ipuWriteCmd(uint32_t value)
+{
+    const uint32_t cmd = (value >> 28u) & 0xFu;
+    const uint32_t arg = value & 0x0FFFFFFFu;
+
+    static uint32_t s_cmdTrace = 0u;
+    if (std::getenv("PS2X_TRACE_IPU") != nullptr && s_cmdTrace < 48u)
+    {
+        std::cerr << "[ipu:cmd] #" << s_cmdTrace << " val=0x" << std::hex << value << std::dec
+                  << " cmd=" << cmd << " arg=" << arg
+                  << " bitPos=" << m_ipuBitPos << " buffered=" << m_ipuIn.size() << std::endl;
+        ++s_cmdTrace;
+    }
+
+    switch (cmd)
+    {
+    case 0x0u: // BCLR: clear the input FIFO, set the bit pointer
+        m_ipuIn.clear();
+        m_ipuBitPos = arg & 0x7Fu;
+        break;
+    case 0x1u: // IDEC
+    case 0x2u: // BDEC
+    case 0x3u: // VDEC
+    case 0x4u: // FDEC (the parser's "fetch bits")
+    case 0x5u: // SETIQ
+    case 0x6u: // SETVQ
+        m_ipuBitPos += (arg & 0x3Fu);
+        break;
+    default: // SETTH / CSC / PACK carry no bit stream
+        break;
+    }
