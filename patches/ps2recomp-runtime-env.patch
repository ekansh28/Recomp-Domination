+                    *reinterpret_cast<uint32_t *>(rdram + kPlayerStateAddr) = 3u;
+                    // Also mark the shell's opening sequence as done so the dispatcher
+                    // skips its boot/logo block on the next pass instead of re-entering
+                    // the LOADBAR scene (whose worker waits on the missing decode).
+                    if (*reinterpret_cast<uint32_t *>(rdram + kShellOpeningDone) == 0u)
+                    {
+                        *reinterpret_cast<uint32_t *>(rdram + kShellOpeningDone) = 1u;
+                        std::cerr << "[DIAG] marked shell opening sequence done (0x4BD710=1)" << std::endl;
+                    }
+                    // The opening scene's per-scene worker never reports completion
+                    // because its decode step feeds on the missing IPU block decoder.
+                    // Retire the wait so the shell can move on to the front-end.
+                    constexpr uint32_t kSceneWorkerDone = 0x29E344u;
+                    constexpr uint32_t kSceneWorkerThread = 0x29E33Cu;
+                    if (*reinterpret_cast<uint32_t *>(rdram + kSceneWorkerDone) == 0u)
+                    {
+                        // Experiment: the loader's worker sleeps in SleepThread and is
+                        // released only once, so its queue never drains. Wake it through
+                        // the guest's own ReleaseWaitThread and see whether the loader
+                        // then completes (this tests the missing-wakeup hypothesis; it
+                        // is not the production fix).
+                        const uint32_t workerId = *reinterpret_cast<uint32_t *>(rdram + kSceneWorkerThread);
+                        if (workerId != 0u && workerId != 0xFFFFFFFFu)
